extend layout

block content
    h1 Register
    form(method='POST' action='/user/register')
        #form-group
            lable Name: 
            input.form-control(name='name', type='text')
        #form-group
            lable Email: 
            input.form-control(name='email', type='email')
        #form-group
            lable Username: 
            textarea.form-control(name='username', type='text')
        #form-group
            lable Password: 
            textarea.form-control(name='password', type='password')
        #form-group
            lable Check: 
            textarea.form-control(name='password2', type='password')
        br
        input.btn.btn-primary(type='submit', value='Submit')